# 34 Moto Kurye İstanbul — production .htaccess
# Otomatik üretildi: scripts/generate-htaccess.js (kaynak: data/redirects.json)

RewriteEngine On

# ── HTTPS + non-www zorunlu (kanonik: https://34motokuryeistanbul.com) ──
RewriteCond %{HTTP_HOST} ^www\.34motokuryeistanbul\.com$ [NC]
RewriteRule ^(.*)$ https://34motokuryeistanbul.com/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://34motokuryeistanbul.com/$1 [L,R=301]

# ── Konsolide edilen ilçe×anahtar kelime sayfaları (301) ──
